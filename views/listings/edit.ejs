<% layout('layouts/boilerplate') %>

<div class="container page-container">

  <div class="form-container">

    <h3 class="form-title">Edit Listing</h3>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" novalidate class="needs-validation">

      <!-- Title -->
      <div class="mb-3">
        <label class="form-label" >Title</label>
        <input 
          name="listing[title]" 
          class="form-control" 
          value="<%= listing.title %>" 
          required
        >
        <div class="invalid-feedback"> Please enter the title !</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea 
          name="listing[description]" 
          class="form-control" 
          rows="3"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback"> Please enter a short description </div>
      </div>

      <!-- Price -->
      <div class="mb-3">
        <label class="form-label">Price (₹)</label>
        <input 
          name="listing[price]" 
          type="number" 
          min="0"
          class="form-control" 
          value="<%= listing.price %>" 
          required
        >
        <div class="invalid-feedback"> Please enter the valid price !</div>
      </div>

      <!-- Location -->
      <%
        const editCoordinates = listing.geometry?.coordinates || [];
        const editLongitude = Number(editCoordinates[0]);
        const editLatitude = Number(editCoordinates[1]);
        const hasEditCoordinates = Number.isFinite(editLatitude) && Number.isFinite(editLongitude);
      %>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">City</label>
          <input 
            name="listing[location][city]" 
            class="form-control" 
            value="<%= listing.location?.city || '' %>"
            required
          >
          <div class="invalid-feedback"> Please enter the valid location !</div>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Area</label>
          <input 
            name="listing[location][area]" 
            class="form-control" 
            value="<%= listing.location?.area || '' %>"
            required
          >
          <div class="invalid-feedback"> Please enter the valid location !</div>
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Address</label>
          <input 
            name="listing[location][address]" 
            class="form-control" 
            value="<%= listing.location?.address || '' %>"
            required
          >
          <div class="invalid-feedback"> Please enter the valid location !</div>
        </div>
      </div>

      <div class="geolocation-panel mb-3">
        <label class="form-label">Choose location on map</label>
        <div
          id="edit-listing-location-picker"
          class="location-picker-map"
          data-location-picker
          data-latitude-target="edit-listing-latitude"
          data-longitude-target="edit-listing-longitude"
          data-status-target="edit-listing-geolocation-status"
          data-default-latitude="<%= hasEditCoordinates ? editLatitude : 18.5204 %>"
          data-default-longitude="<%= hasEditCoordinates ? editLongitude : 73.8567 %>"
          <% if (hasEditCoordinates) { %>
          data-initial-latitude="<%= editLatitude %>"
          data-initial-longitude="<%= editLongitude %>"
          <% } %>
        ></div>
        <button
          type="button"
          class="geolocation-btn"
          data-geolocation-button
          data-picker-target="edit-listing-location-picker"
          data-latitude-target="edit-listing-latitude"
          data-longitude-target="edit-listing-longitude"
          data-status-target="edit-listing-geolocation-status"
        >
          Use my current location
        </button>
        <input
          type="hidden"
          id="edit-listing-latitude"
          name="listing[locationCoordinates][latitude]"
          value="<%= hasEditCoordinates ? editLatitude : '' %>"
        >
        <input
          type="hidden"
          id="edit-listing-longitude"
          name="listing[locationCoordinates][longitude]"
          value="<%= hasEditCoordinates ? editLongitude : '' %>"
        >
        <p id="edit-listing-geolocation-status" class="geolocation-status">
          Click the map to update the room marker, or keep the current marker.
        </p>
      </div>

      <!-- Images -->
      <div class="mb-3">
        <label class="form-label">Add More Room Images</label>
        <input
          name="images"
          type="file"
          class="form-control"
          accept="image/*"
          multiple
          data-image-preview-input
          data-image-preview-target="edit-image-preview"
        >
        <div class="upload-help">Leave this empty to keep current images, or upload more room photos.</div>

        <div id="edit-image-preview" class="selected-image-preview d-none" aria-live="polite">
          <p class="image-preview-heading">New image preview</p>
          <div class="image-preview-grid" data-image-preview-grid></div>
        </div>

        <% if (listing.images && listing.images.length > 0) { %>
        <div class="image-preview-grid mt-3">
          <% for (let image of listing.images) { %>
          <label class="image-preview-card image-select-card">
            <img src="<%= image.url %>" alt="Room image preview" class="image-preview-thumb">
            <span class="image-select-meta">
              <input type="checkbox" name="deleteImages" value="<%= image.filename %>" class="image-select-checkbox">
              <span class="image-select-text">Remove this image</span>
            </span>
          </label>
          <% } %>
        </div>
        <% } %>
      </div>

      <!-- Amenities -->
      <div class="mb-3">
        <label class="form-label">Amenities</label>
        <input 
          name="listing[amenities]" 
          class="form-control" 
          value="<%= listing.amenities?.join(', ') || '' %>"
          required
        >
      </div>

      <!-- Rating -->
      <div class="mb-3">
        <label class="form-label">Rating</label>
        <input 
          name="listing[rating]" 
          type="number" 
          step="0.1" 
          class="form-control" 
          value="<%= listing.rating || 0 %>"
          required
        >
      </div>

      <!-- Submit -->
      <button type="submit" class="submit-btn">
        Update Listing
      </button>

    </form>

  </div>

</div>
