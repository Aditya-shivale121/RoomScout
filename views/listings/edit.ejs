<% layout('layouts/boilerplate') %>

<div class="container page-container">

  <div class="form-container">

    <h3 class="form-title">Edit Listing</h3>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

      <!-- Title -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input 
          name="title" 
          class="form-control" 
          value="<%= listing.title %>" 
          required
        >
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea 
          name="description" 
          class="form-control" 
          rows="3"
        ><%= listing.description %></textarea>
      </div>

      <!-- Price -->
      <div class="mb-3">
        <label class="form-label">Price (₹)</label>
        <input 
          name="price" 
          type="number" 
          class="form-control" 
          value="<%= listing.price %>" 
          required
        >
      </div>

      <!-- Location -->
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">City</label>
          <input 
            name="location[city]" 
            class="form-control" 
            value="<%= listing.location?.city || '' %>"
          >
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Area</label>
          <input 
            name="location[area]" 
            class="form-control" 
            value="<%= listing.location?.area || '' %>"
          >
        </div>

        <div class="col-md-4 mb-3">
          <label class="form-label">Address</label>
          <input 
            name="location[address]" 
            class="form-control" 
            value="<%= listing.location?.address || '' %>"
          >
        </div>
      </div>

      <!-- Image -->
      <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input 
          name="images[0][url]" 
          class="form-control" 
          value="<%= listing.images[0]?.url || '' %>"
        >
      </div>

      <!-- Amenities -->
      <div class="mb-3">
        <label class="form-label">Amenities</label>
        <input 
          name="amenities" 
          class="form-control" 
          value="<%= listing.amenities?.join(', ') || '' %>"
        >
      </div>

      <!-- Rating -->
      <div class="mb-3">
        <label class="form-label">Rating</label>
        <input 
          name="rating" 
          type="number" 
          step="0.1" 
          class="form-control" 
          value="<%= listing.rating || 0 %>"
        >
      </div>

      <!-- Submit -->
      <button type="submit" class="submit-btn">
        Update Listing
      </button>

    </form>

  </div>

</div>