<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RoomScout</title>
</head>
<body>

<h3>Edit Listing</h3>

<form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

<input name="title" value="<%= listing.title %>"><br><br>

<input name="description" value="<%= listing.description %>"><br><br>

<input name="price" type="number" value="<%= listing.price %>"><br><br>

<!-- Location -->
<input name="location[address]" value="<%= listing.location.address %>"><br><br>
<input name="location[area]" value="<%= listing.location.area %>"><br><br>
<input name="location[city]" value="<%= listing.location.city %>"><br><br>

<!-- Image -->
<input name="images[0][url]" value="<%= listing.images[0].url %>"><br><br>

<!-- Amenities -->
<input name="amenities" value="<%= listing.amenities.join(',') %>"><br><br>

<input name="rating" type="number" step="0.1" value="<%= listing.rating %>"><br><br>

<button type="submit">Update</button>

</form>

</body>
</html>