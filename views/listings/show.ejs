<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RoomScout</title>
</head>
<body>
    <h3>Listing Details: </h3>
   <h3>Listing Details:</h3>

<ul>
    <li><strong>Title:</strong> <%= listing.title %></li>

    <li><strong>Description:</strong> <%= listing.description %></li>

    <li><strong>Price:</strong> ₹<%= listing.price.toLocaleString("en-IN") %></li>

    <li>
        <strong>Location:</strong>
        <%= listing.location.address %>,
        <%= listing.location.area %>,
        <%= listing.location.city %>
    </li>

    <li>
        <strong>Images:</strong><br>
        <% listing.images.forEach(img => { %>
            <img src="<%= img.url %>" width="200">
        <% }) %>
    </li>

    <li>
        <strong>Amenities:</strong>
        <%= listing.amenities.join(", ") %>
    </li>

    <li><strong>Rating:</strong> <%= listing.rating %></li>

    <li><strong>Available:</strong> <%= listing.available %></li>

    <li>
        <strong>Created:</strong>
        <%= listing.createdAt.toDateString() %>
    </li>
</ul>
<br>
<a href="/listings/<%= listing._id %>/edit">Edit This Listing</a>
<br><br>
<form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
    <button onclick="return confirm('Delete this listing?')">
        Delete
    </button>
</form>
</body>
</html> 