<% layout('layouts/boilerplate') %>

<div class="container page-container">

  <h3>Listing Details</h3>

  <div class="card show-card">

    <!-- Image -->
    <img 
      src="<%= listing.images[0]?.url || 'https://via.placeholder.com/600' %>" 
      class="show-img"
      alt="listing-image"
    >

    <div class="card-body">

      <!-- Title -->
      <h4 class="show-title"><%= listing.title %></h4>

      <!-- Price -->
      <p class="show-price">
        ₹ <%= listing.price.toLocaleString("en-IN") %> / month
      </p>

      <!-- Location -->
      <p class="show-location">
        <%= listing.location?.address %>, 
        <%= listing.location?.area %>, 
        <%= listing.location?.city %>
      </p>

      <!-- Description -->
      <p class="show-desc">
        <%= listing.description %>
      </p>

      <!-- Amenities -->
      <p class="show-amenities">
        <strong>Amenities:</strong>
        <%= listing.amenities?.join(", ") %>
      </p>

      <!-- Rating -->
      <p class="show-rating">
        ⭐ <%= listing.rating %>
      </p>

      <!-- Actions -->
      <div class="show-actions">

        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
          Edit
        </a>

        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
          <button 
            class="btn delete-btn"
            onclick="return confirm('Delete this listing?')"
          >
            Delete
          </button>
        </form>

      </div>

      <!-- Add Review Form -->
      <div class="review-section mt-4">
        <h5>Add Your Review</h5>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mb-4">
          <div class="mb-3">
            <label class="form-label">Rating:</label>
            <select name="review[rating]" class="form-select" required>
              <option value="1">1 - Poor</option>
              <option value="2">2 - Fair</option>
              <option value="3">3 - Good</option>
              <option value="4">4 - Very Good</option>
              <option value="5">5 - Excellent</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Review:</label>
            <textarea name="review[body]" class="form-control" rows="3" required placeholder="Share your experience..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </form>
      </div>

      <!-- Reviews List -->
      <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="reviews-list mt-4">
        <h5>Reviews (<%= listing.reviews.length %>)</h5>
        <% for (let review of listing.reviews) { %>
        <div class="review-item mb-3 p-3 bg-light border rounded">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="h6 mb-0">⭐ <%= review.rating %> / 5</span>
            <small class="text-muted"><%= review.createdAt.toLocaleDateString() %></small>
          </div>
          <p class="mb-2"><%= review.body %></p>
          <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" style="display: inline;">
            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this review?')">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
      <% } else { %>
      <div class="no-reviews mt-4 text-center text-muted">
        <p>No reviews yet. <strong>Be the first to review this listing!</strong></p>
      </div>
      <% } %>

    </div>

  </div>

</div>