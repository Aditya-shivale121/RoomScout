<% layout('layouts/boilerplate') %>

<div class="container form-container">

  <h3 class="form-title">Create New Listing</h3>

  <form action="/listings" method="POST" novalidate class="needs-validation">

    <!-- Title -->
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input name="title" class="form-control" placeholder="Enter title" required>
      <div class="valid-feedback">
      Looks good!
    </div>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="3" placeholder="Enter description" required ></textarea>
      <div class="invalid-feedback"> Please enter a short description </div>
    </div>

    <!-- Price -->
    <div class="mb-3">
      <label class="form-label">Price (₹)</label>
      <input name="price" type="number" class="form-control" placeholder="Enter price" required>
      <div class="invalid-feedback"> Price should be valid  ! </div>
    </div>

    <!-- Location -->
    <div class="row">
      <div class="col-md-4 mb-3" >
        <label class="form-label">City</label>
        <input name="location[city]" class="form-control" required>
        <div class="invalid-feedback"> Location should be valid  ! </div>
      </div>

      <div class="col-md-4 mb-3" >
        <label class="form-label">Area</label>
        <input name="location[area]" class="form-control " required>

      </div>

      <div class="col-md-4 mb-3 ">
        <label class="form-label">Address</label>
        <input name="location[address]" class="form-control" required>
      </div>
    </div>

    <!-- Image -->
    <div class="mb-3 ">
      <label class="form-label">Image URL</label>
      <input name="images[0][url]" class="form-control" placeholder="Paste image URL" required>
    </div>

    <!-- Amenities -->
    <div class="mb-3">
      <label class="form-label">Amenities</label>
      <input name="amenities" class="form-control" placeholder="WiFi, Parking, Laundry" required>
    </div>

    <!-- Rating -->
    <div class="mb-3">
      <label class="form-label">Rating</label>
      <input name="rating" type="number" min="0" max="5" step="0.1" class="form-control" placeholder="0 to 5" required>
    </div>
   

    <!-- Submit -->
    <button type="submit" class="submit-btn">Create Listing</button>
     

  </form>

</div>