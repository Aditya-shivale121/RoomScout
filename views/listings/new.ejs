<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RoomScout</title>
</head>
<body>

<h3>Create Listing</h3>

<form action="/listings" method="POST">

<input name="title" placeholder="Title"><br><br>

<input name="description" placeholder="Description"><br><br>

<input name="price" type="number" placeholder="Price"><br><br>

<!-- Location -->
<input name="location[address]" placeholder="Address"><br><br>
<input name="location[area]" placeholder="Area"><br><br>
<input name="location[city]" placeholder="City"><br><br>

<!-- Image -->
<input name="images[0][url]" placeholder="Image URL"><br><br>

<!-- Amenities (comma separated) -->
<input name="amenities" placeholder="WiFi,Parking,Laundry"><br><br>

<input name="rating" type="number" step="0.1" placeholder="Rating"><br><br>

<button type="submit">Create Listing</button>

</form>

</body>
</html>