<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show mt-3 app-alert" role="alert">
    <%= success.join(" ") %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show mt-3 app-alert" role="alert">
    <%= error.join(" ") %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
